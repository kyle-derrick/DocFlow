# DocFlow 生产环境 .env 模板
#
# 用法：cp .env.production.example .env && 逐项替换 CHANGE_ME 占位符。
# 密钥生成：openssl rand -hex 32（JWT/ONLYOFFICE）；openssl rand -hex 16（MEILI_MASTER_KEY）。
#
# 启动矩阵（按需叠加，compose 会自动拉起依赖）：
#   基础栈      docker compose --profile minimal up -d --build
#   +Redis/编辑器（推荐） make up-full
#   +病毒扫描   追加 --profile antivirus            （联动 SCAN_ENABLED=true）
#   +全文搜索   追加 --profile search               （联动 SEARCH_DRIVER=meili）
#   +对象存储   追加 --profile storage              （联动 STORAGE_DRIVER=s3）
# 停止全部：make down（已含全部 profile）。

# ============ 必填：核心与数据库 ============
# HS256 签名密钥（≥32 字节随机串）。
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# PostgreSQL（compose 内主机名固定 postgres；密码与下行 POSTGRES_PASSWORD 一致）。
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://docflow:CHANGE_ME@postgres:5432/docflow?sslmode=disable
# 初始管理员（幂等 seed，仅首次建库生效；首次登录后立即改密）。
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_ROLE=admin

# ============ 必填：域名与入口 ============
# 对外域名（caddy 站点地址，自动签发 HTTPS 证书；本地验证用 :80）。
APP_DOMAIN=docflow.example.com
# 站点对外基地址：邮件邀请/重置链接、分享链接、OIDC 回调的前缀。
PUBLIC_BASE_URL=https://docflow.example.com
# 独立内容 origin（网页包预览 /content 域，建议独立域名；不设可保持默认走主站路径）。
CONTENT_DOMAIN=content.example.com
# 会话 cookie 仅经 HTTPS 传输（生产保持 true）。
COOKIE_SECURE=true
# cookie 域留空 = 当前域；多子域共享会话时填 .example.com。
COOKIE_DOMAIN=
# 采信 caddy 转发的 X-Forwarded-For（compose 内网段，防伪造绕过限流）。
TRUSTED_PROXIES=172.16.0.0/12

# ============ 推荐：后台队列（多实例/横向扩展必选） ============
# full profile。redis 同时承载任务队列与 WebSocket 跨实例广播。
QUEUE_DRIVER=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
QUEUE_CONCURRENCY=5

# ============ 可选：S3 对象存储（storage profile，需先建 bucket） ============
# 多实例部署必须 S3（local 驱动为单机实现）。
# MinIO 建桶：docker compose --profile storage up -d minio 后，
#   docker run --rm --network docflow_default minio/mc:latest \
#     alias set local http://minio:9000 <ACCESS_KEY> <SECRET_KEY> && \
#     docker run --rm --network docflow_default minio/mc:latest mb local/docflow
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docflow
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PATH_STYLE=true

# ============ 可选：病毒扫描（antivirus profile） ============
# clamd 首次启动下载病毒库需数分钟（期间上传 fail closed 拒绝）。
SCAN_ENABLED=true
CLAMAV_ADDR=clamav:3310
CLAMAV_TIMEOUT=5m
# true = clamd 不可达即拒绝上传（fail closed，生产保持 true）。
CLAMAV_REQUIRED=true

# ============ 可选：全文搜索（search profile） ============
# MASTER_KEY ≥16 字节，须与 MEILI_API_KEY 同值。
SEARCH_DRIVER=meili
MEILI_URL=http://meilisearch:7700
MEILI_API_KEY=CHANGE_ME_openssl_rand_hex_16
MEILI_MASTER_KEY=CHANGE_ME_openssl_rand_hex_16

# ============ 可选：ONLYOFFICE（full profile） ============
# JWT_SECRET ≥32 字节，与 onlyoffice 服务共享（compose 强制校验非空）。
# PUBLIC_URL 为浏览器经 caddy /onlyoffice/* 反代的地址；SERVER_URL 保持内网
# 名（同时是回调防 SSRF 校验基准）；DOWNLOAD_URL_BASE 为 DS 回源后端地址。
ONLYOFFICE_ENABLED=true
ONLYOFFICE_SERVER_URL=http://onlyoffice:80
ONLYOFFICE_PUBLIC_URL=https://docflow.example.com/onlyoffice
ONLYOFFICE_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ONLYOFFICE_DOWNLOAD_URL_BASE=http://backend:8080
ONLYOFFICE_UPSTREAM=onlyoffice:80

# ============ 可选：draw.io 图表编辑（full profile） ============
DRAWIO_ENABLED=true
DRAWIO_SERVER_URL=http://drawio:8080
DRAWIO_PUBLIC_URL=https://docflow.example.com/drawio
DRAWIO_UPSTREAM=drawio:8080

# ============ 可选：SMTP 邮件（邀请注册/密码重置链接投递） ============
# 不启用则链接仅输出到后端日志（[mail:noop]），管理员可从邀请管理页复制。
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=docflow@example.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=docflow@example.com

# ============ 可选：OIDC 单点登录 ============
# 启用即与 IdP 强耦合：启动时拉取 discovery 失败会拒绝启动（IdP 须先可达）。
# 回调地址默认 {PUBLIC_BASE_URL}/api/v1/auth/oidc/callback，需在 IdP 侧注册。
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_AUTO_PROVISION=true

# ============ 可选：AI 文件摘要（OpenAI 兼容网关） ============
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ============ 观测与运维（默认即可） ============
# /metrics 无认证且不经 caddy 暴露，仅 compose 内网可抓取。
METRICS_ENABLED=true
JANITOR_ENABLED=true
JANITOR_INTERVAL=10m

# ============ 一般无需调整 ============
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MAX_FILE_SIZE=2147483648
PATCH_MAX_BYTES=67108864
UPLOAD_SESSION_TTL=24h
MAX_VERSIONS_PER_FILE=5
RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT_PER_MIN=10
PUBLIC_RATE_LIMIT_PER_MIN=60
WEBPKG_ENABLED=true
# 国内网络构建加速（Go 模块代理），海外部署留空。
GOPROXY=

# DocFlow 场景模板 4/4：多实例集群（横向扩展，外置 PG/Redis/S3）
# =============================================================================
# 适用：backend 副本 >1（多节点或多容器）承载较大并发/高可用诉求。
#       前端静态产物由每个节点的 caddy 各自服务；状态一律外置，
#       使任意实例可处理任意请求。
#
# 【重要】本文件是 compose 的 .env。多实例部署通常不再用仓库默认的
#        docker-compose.yml（其 postgres/redis/minio 是单机容器），而是：
#          - 外置托管 PostgreSQL / Redis / S3（推荐），或
#          - 自建高可用 PG/Redis/S3 集群
#        然后把下列 *_ADDR / *_ENDPOINT 指向这些外部地址。
#
# 【多实例硬性约束】以下三条不满足会导致功能异常，不是性能优化项：
#   1. QUEUE_DRIVER=redis —— 后台任务队列必须共享；inprocess 会让任务只在
#      产生它的实例执行，且 WebSocket 站内通知无法跨实例送达。
#      同一 Redis 还承载 docflow:notify 跨实例广播。
#   2. STORAGE_DRIVER=s3 —— local 驱动是单机实现，副本间看不到彼此的文件。
#   3. 粘性会话 —— 富文本多人协作（internal/collab）的房间是单实例内存态。
#      同一文件的编辑连接必须落到同一实例（按文件 ID / URL 哈希做
#      sticky，或在入口层做 session affinity），否则协作无法收敛。
#      实现方式：入口负载均衡（Nginx/HAProxy/LB）按 cookie 或路径 hash 粘性。
#
# 用法：
#   cp deploy/env/.env.cluster.example .env
#   # 1) 替换全部 CHANGE_ME；密钥每套部署独立生成
#   # 2) 把 *_ADDR / *_ENDPOINT 指向外置 PostgreSQL / Redis / S3
#   # 3) 各节点用同一份 .env 启动（密钥/域名/外部地址必须完全一致）
#   #    副本数按 docker-compose 的 --scale backend=N 或编排层副本数设置
#   docker compose --profile full --profile search up -d --build --scale backend=3
#
# 【注意】镜像构建（backend/caddy）只需在一个节点或 CI 完成并推送镜像仓库，
#        各节点 docker pull 复用，避免重复构建。
# =============================================================================

DOCFLOW_IMAGE_TAG=1.0.0
NPM_REGISTRY=https://registry.npmjs.org/
GOPROXY=https://goproxy.cn

# ============ 必填：密钥（各节点必须一致，否则会话/令牌互不认）============
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ============ 必填：外置 PostgreSQL（托管或自建 HA）============
# 指向外部 PG，而非 compose 内 postgres 服务名。
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgres://docflow:CHANGE_ME_strong_db_password@pg.internal:5432/docflow?sslmode=require
# 生产外置 PG 建议启用 TLS：把 sslmode=disable 改为 require/verify-full 并配 CA。

# ============ 必填：管理员 ============
# 多实例下 migrate/seed 只允许一个实例执行（幂等但不建议并发跑）：
#   docker compose run --rm migrate   # 单独跑一次，再启动多副本
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
SEED_ADMIN_ROLE=admin

# ============ 必填：域名与入口 ============
APP_DOMAIN=docflow.example.com
PUBLIC_BASE_URL=https://docflow.example.com
CONTENT_DOMAIN=content.example.com
COOKIE_SECURE=true
# 多子域/多节点共享会话时填主域（如前缀带点），否则留空。
COOKIE_DOMAIN=
# 必须设为入口负载均衡所在网段，否则限流会按 LB 的 IP 计数（全体用户共用一个额度）。
TRUSTED_PROXIES=172.16.0.0/12
# 多实例 + 明确前端域名时建议显式声明 WebSocket 允许的 Origin。
ALLOWED_ORIGINS=https://docflow.example.com
# 运行环境标识设为 production。
APP_ENV=production

# ============ 【多实例约束 1】队列：必须 redis ============
# 指向外置 Redis；同时承载 asynq 任务队列与 docflow:notify 跨实例广播。
# 启动时 ping 失败即退出（fail fast）。
QUEUE_DRIVER=redis
REDIS_ADDR=redis.internal:6379
# 外置 Redis 务必设密码；留空 = 无认证。
REDIS_PASSWORD=CHANGE_ME_redis_password
# 每个实例的并行处理数：总吞吐 ≈ 副本数 × 本值。
QUEUE_CONCURRENCY=5

# ============ 【多实例约束 2】存储：必须 s3 ============
# 指向外置 S3（AWS S3 / MinIO 集群 / 兼容对象存储）。
# bucket 需提前创建；多实例共享同一 bucket。
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.internal
S3_BUCKET=docflow
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_s3_access_key
S3_SECRET_KEY=CHANGE_ME_s3_secret_key
# 自建 MinIO 等保持 true；AWS S3 用 false。
S3_PATH_STYLE=false

# ============ 全文搜索（可选，--profile search）============
# Meilisearch 为单实例时各 backend 共享同一实例即可；
# 大规模场景建议托管 Meilisearch Cloud 或自建集群，并指向其地址。
SEARCH_DRIVER=meili
MEILI_URL=http://meilisearch.internal:7700
MEILI_API_KEY=CHANGE_ME_openssl_rand_hex_16
MEILI_MASTER_KEY=CHANGE_ME_openssl_rand_hex_16

# ============ ONLYOFFICE（可选，--profile full）============
# 多实例下 ONLYOFFICE 可独立部署为共享服务，各 backend 指向同一 DS。
ONLYOFFICE_ENABLED=true
ONLYOFFICE_SERVER_URL=http://onlyoffice.internal:80
ONLYOFFICE_PUBLIC_URL=https://docflow.example.com/onlyoffice
ONLYOFFICE_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# DS 回源后端：需指向入口负载均衡，而非单个 backend 实例，
# 否则回调可能落到非处理该请求的实例。
ONLYOFFICE_DOWNLOAD_URL_BASE=https://docflow.example.com

# ============ draw.io（静态层在 caddy 镜像内，各节点自带）============
DRAWIO_ENABLED=true
DRAWIO_SERVER_URL=https://docflow.example.com/drawio
DRAWIO_PUBLIC_URL=https://docflow.example.com/drawio

# ============ 邮件 ============
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=docflow@example.com
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=docflow@example.com

# ============ 病毒扫描（可选，建议独立部署 clamd 集群）============
# 多实例场景建议把 clamav 部署为共享服务；各实例指向其地址。
# 若不用共享服务且每节点自带 clamav，需叠加 --profile antivirus。
SCAN_ENABLED=false
CLAMAV_ADDR=clamav.internal:3310
CLAMAV_TIMEOUT=5m
CLAMAV_REQUIRED=true

# ============ 限流：生产值 ============
# 【注意】进程内限流为内存实现，多实例下各实例独立计数，
# 实际阈值 ≈ 副本数 × 本值。如需全局精确限流，请在入口层配合处理。
RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT_PER_MIN=10
PUBLIC_RATE_LIMIT_PER_MIN=60

# ============ TLS 热切换（多节点需逐个下发）============
# 管理页 TLS 切换经 CADDY_ADMIN_ADDR 下发到「本实例」的 caddy；
# 多节点场景每面 caddy 需各自配置，或统一由 IaC/配置管理下发。
CADDY_ADMIN_ADDR=caddy:2019
TLS_CERT_DIR=/data/tls

# ============ 可选：OIDC ============
# 多实例下回调地址必须指向入口负载均衡（唯一对外域名）。
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_AUTO_PROVISION=true

# ============ 可选：AI ============
# 多实例共用同一 AI 网关即可。
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ============ 观测与运维 ============
# 各实例均暴露 /metrics，Prometheus 按副本分别抓取。
METRICS_ENABLED=true
JANITOR_ENABLED=true
# 【注意】janitor 多实例会各自跑清理，逻辑幂等但有重复开销；
# 如需单点执行，可只在一个实例置 true、其余 false。
JANITOR_INTERVAL=10m

# ============ 一般无需调整 ============
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MAX_FILE_SIZE=2147483648
PATCH_MAX_BYTES=67108864
UPLOAD_SESSION_TTL=24h
MAX_VERSIONS_PER_FILE=5
WEBPKG_ENABLED=true

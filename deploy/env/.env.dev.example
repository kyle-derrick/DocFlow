# DocFlow 场景模板 1/4：本地开发（裸机，不经 Docker Compose）
# =============================================================================
# 适用：在本机直接跑 Go 后端（make run / go run ./cmd/server）+ vite dev server，
#       自己起一个 PostgreSQL 容器。改动代码即时生效，不需要重建镜像。
#
# 【重要】后端只读「进程环境变量」，不解析 .env 文件（internal/config 无 dotenv）。
#         compose 里的 .env 只用于变量插值，与裸机运行无关。
#         因此本文件是「变量清单 + 取值参考」，用法是把下列变量导出到 shell，
#         而不是 cp 成 .env 后 make run。
#
# 前置：PostgreSQL 可达（示例）：
#   docker run -d --name docflow-pg -p 5432:5432 \
#     -e POSTGRES_DB=docflow -e POSTGRES_USER=docflow \
#     -e POSTGRES_PASSWORD=change-me postgres:16-alpine
#
# 用法（二选一）：
#   PowerShell：
#     $env:DATABASE_URL="postgres://docflow:change-me@localhost:5432/docflow?sslmode=disable"
#     $env:JWT_SECRET="dev-only-jwt-secret-0123456789abcdef012345"
#     $env:COOKIE_SECURE="false"
#     make run        # 后端 :8080；Windows 无 make 时改用：go run ./cmd/server
#   bash：
#     export DATABASE_URL="postgres://docflow:change-me@localhost:5432/docflow?sslmode=disable"
#     export JWT_SECRET="dev-only-jwt-secret-0123456789abcdef012345"
#     export COOKIE_SECURE=false
#     make run        # Windows 无 make 时改用：go run ./cmd/server
#
# 前端（另一个终端，无需额外变量；vite 把 /api 代理到 :8080）：
#   cd frontend && npm install && npm run dev    # http://localhost:5173
#
# 首次建表 + 建管理员（需同样导出 DATABASE_URL）：
#   make migrate && make seed     # 等价：go run ./cmd/migrate && go run ./cmd/seed
# =============================================================================

# ---- 必填 ----
# HS256 会话签名密钥：≥32 字节。开发值可固定，切勿用于生产。
JWT_SECRET=dev-only-jwt-secret-0123456789abcdef012345
# PostgreSQL 连接串（本机直连 localhost，注意用 localhost 而非 compose 服务名）。
DATABASE_URL=postgres://docflow:change-me@localhost:5432/docflow?sslmode=disable

# ---- 本地 HTTP 必需 ----
# 默认 true，本机 http://localhost 访问时必须显式设 false，
# 否则浏览器不回传 refresh cookie，登录无法保持。
COOKIE_SECURE=false
PORT=8080
APP_ENV=development

# ---- 初始管理员（make seed 幂等，仅首次建库生效）----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=AdminPassword123
SEED_ADMIN_ROLE=admin

# ---- 存储（本地目录）----
STORAGE_DRIVER=local
STORAGE_ROOT=./storage

# ---- 队列 / 搜索 / 邮件：开发期用零依赖默认值 ----
QUEUE_DRIVER=inprocess
SEARCH_DRIVER=pg
SMTP_ENABLED=false

# ---- 限流：开发期放开，避免自测被限流拦截 ----
# 恢复生产语义改为 120 / 10 / 60。
RATE_LIMIT_PER_MIN=0
LOGIN_RATE_LIMIT_PER_MIN=0
PUBLIC_RATE_LIMIT_PER_MIN=0

# ---- 可选集成：开发期默认全关，需要时再开 ----
# 富文本协作、draw.io、ONLYOFFICE 等编辑器在开发期按需启用；
# ONLYOFFICE 需本地有 DocumentServer（例如 docker run -p 8081:80 onlyoffice/documentserver:8.2.3），
# 并同时设 ONLYOFFICE_PUBLIC_URL=http://localhost:8081。
ONLYOFFICE_ENABLED=false
DRAWIO_ENABLED=false
AI_ENABLED=false
OIDC_ENABLED=false

# ---- 一般无需调整（开发期为默认值）----
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MAX_FILE_SIZE=2147483648
MAX_VERSIONS_PER_FILE=5
UPLOAD_SESSION_TTL=24h
JANITOR_ENABLED=true
JANITOR_INTERVAL=10m

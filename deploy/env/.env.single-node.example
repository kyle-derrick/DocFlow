# DocFlow 场景模板 3/4：单机生产（Docker Compose，单域名 + 自动 HTTPS）
# =============================================================================
# 适用：一台公网服务器（或内网服务器 + 企业证书）面向真实用户提供服务的
#       最小生产形态。Caddy 自动申请/续期 Let's Encrypt 证书，全站 HTTPS。
#
# 【重要】本文件是 compose 的 .env。backend 容器环境变量由 docker-compose.yml
#        注入；.env 只做变量插值，Go 进程本身不解析该文件。
#
# 用法：
#   cp deploy/env/.env.single-node.example .env
#   # 1) 替换全部 CHANGE_ME（密钥用 openssl rand -hex 32 生成）
#   # 2) 把 APP_DOMAIN / PUBLIC_BASE_URL 改成你的真实域名
#   # 3) 域名 A 记录需已解析到本机；80/443 需对公网开放（ACME HTTP 挑战）
#   docker compose --profile full --profile search --profile storage up -d --build
#   首次登录后立即修改管理员密码。
#
# 与「验证」模板的关键差异：
#   - COOKIE_SECURE=true（HTTPS 必需）
#   - APP_DOMAIN 设真实域名 → Caddy 自动签发证书
#   - 限流恢复生产值；密钥全部随机
#   - 存储用 S3/MinIO（便于备份与后续扩容到集群）
# =============================================================================

DOCFLOW_IMAGE_TAG=1.0.0
NPM_REGISTRY=https://registry.npmjs.org/
# 国内网络留空则走官方 proxy.golang.org；海外部署建议留空。
GOPROXY=https://goproxy.cn

# ============ 必填：密钥（全部替换，勿沿用示例值）============
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgres://docflow:CHANGE_ME_strong_db_password@postgres:5432/docflow?sslmode=disable

# ============ 必填：管理员（首次建库生效，登录后立即改密）============
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
# 至少 12 位，须含大小写字母+数字
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
SEED_ADMIN_ROLE=admin

# ============ 必填：域名与入口 ============
# 真实域名：Caddy 站点地址，自动签发 HTTPS 证书。
APP_DOMAIN=docflow.example.com
# 站点对外基地址：邮件邀请/重置链接、分享链接、OIDC 回调前缀。
PUBLIC_BASE_URL=https://docflow.example.com
# 独立内容 origin：建议独立域名（需自行解析并签发证书）；
# 暂不具备时可保持默认走主站 /content/* 路径。
CONTENT_DOMAIN=content.example.com
# HTTPS 下必须 true（浏览器仅经 TLS 回传 refresh cookie）。
COOKIE_SECURE=true
# 留空 = 当前域；多子域共享会话时填 .example.com。
COOKIE_DOMAIN=
# 采信 caddy 转发的 X-Forwarded-For（compose 内网段）。
TRUSTED_PROXIES=172.16.0.0/12

# ============ 后台队列：单机亦推荐 redis（功能完整 + 便于日后扩容）============
# 需要 --profile full。
QUEUE_DRIVER=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
QUEUE_CONCURRENCY=5

# ============ 存储：S3/MinIO（--profile storage）============
# 【注意】STORAGE_DRIVER=s3 必须叠加 --profile storage，且 bucket 需提前创建：
#   docker compose --profile storage up -d minio
#   docker run --rm --network docflow_default quay.io/minio/mc:latest \
#     alias set local http://minio:9000 <ACCESS_KEY> <SECRET_KEY> && \
#     docker run --rm --network docflow_default quay.io/minio/mc:latest mb local/docflow
# 单机也可用 STORAGE_DRIVER=local（然后去掉 --profile storage）：
# local 数据落在 backend_storage 卷，备份需一并处理该卷。
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docflow
S3_REGION=us-east-1
# 同时作为 MinIO 的 root 凭据，务必替换。
S3_ACCESS_KEY=CHANGE_ME_s3_access_key
S3_SECRET_KEY=CHANGE_ME_s3_secret_key
S3_PATH_STYLE=true

# ============ 全文搜索：Meilisearch（--profile search）============
SEARCH_DRIVER=meili
MEILI_URL=http://meilisearch:7700
# openssl rand -hex 16，两个 KEY 必须同值。
MEILI_API_KEY=CHANGE_ME_openssl_rand_hex_16
MEILI_MASTER_KEY=CHANGE_ME_openssl_rand_hex_16

# ============ ONLYOFFICE 在线编辑（--profile full）============
ONLYOFFICE_ENABLED=true
ONLYOFFICE_SERVER_URL=http://onlyoffice:80
# 浏览器经 caddy 反代的地址（必须是对外域名，否则浏览器加载不了 api.js）。
ONLYOFFICE_PUBLIC_URL=https://docflow.example.com/onlyoffice
# openssl rand -hex 32；与 onlyoffice 服务共享，compose 强制非空。
ONLYOFFICE_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ONLYOFFICE_DOWNLOAD_URL_BASE=http://backend:8080
ONLYOFFICE_UPSTREAM=onlyoffice:80

# ============ draw.io 图表编辑（静态层已并入 caddy，无独立服务）============
DRAWIO_ENABLED=true
DRAWIO_SERVER_URL=https://docflow.example.com/drawio
DRAWIO_PUBLIC_URL=https://docflow.example.com/drawio

# ============ 邮件：生产建议启用（否则邀请/重置链接只在日志里）============
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=docflow@example.com
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=docflow@example.com

# ============ 病毒扫描：生产推荐启用（--profile antivirus）============
# 启用后需叠加 --profile antivirus；clamd 首次启动下载病毒库需数分钟。
SCAN_ENABLED=true
CLAMAV_ADDR=clamav:3310
CLAMAV_TIMEOUT=5m
# true = clamd 不可达即拒绝上传（fail closed，生产保持 true）。
CLAMAV_REQUIRED=true

# ============ 限流：恢复生产值 ============
RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT_PER_MIN=10
PUBLIC_RATE_LIMIT_PER_MIN=60

# ============ 可选：OIDC 单点登录 ============
# 启用前须确保 IdP 可达，否则后端启动时拉取 discovery 失败会拒绝启动。
# 回调地址默认 {PUBLIC_BASE_URL}/api/v1/auth/oidc/callback，需在 IdP 侧注册。
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_AUTO_PROVISION=true

# ============ 可选：AI（OpenAI 兼容网关）============
# 也可留 false，部署后在「平台管理 → AI 设置」在线配置。
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ============ 观测与运维 ============
# /metrics 无认证且不经 Caddy 暴露，仅 compose 内网可抓取。
METRICS_ENABLED=true
JANITOR_ENABLED=true
JANITOR_INTERVAL=10m

# ============ 一般无需调整 ============
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MAX_FILE_SIZE=2147483648
PATCH_MAX_BYTES=67108864
UPLOAD_SESSION_TTL=24h
MAX_VERSIONS_PER_FILE=5
WEBPKG_ENABLED=true

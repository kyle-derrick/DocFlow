# DocFlow 场景模板 2/4：单机验证（Docker Compose，HTTP + localhost）
# =============================================================================
# 适用：一台机器（含 Windows + Docker Desktop）快速拉起全功能栈做验收/联调。
#       通过 http://localhost/ 或 http://127.0.0.1/ 访问，不开 TLS、不暴露公网。
#       本模板即当前仓库 .env 的「验证环境」形态。
#
# 【重要】本文件是 compose 的 .env：被 docker compose 读取做变量插值，
#         backend 容器内的环境变量由 docker-compose.yml 注入，与此文件一一对应。
#
# 用法：
#   cp deploy/env/.env.local-verify.example .env
#   # 调整密码/密钥占位（下列值已可直接用于内网验证，勿用于生产）
#   docker compose --profile full --profile search --profile storage up -d --build
#   # 浏览器打开 http://localhost/
#   # 停止：docker compose --profile full --profile search --profile storage down
#
# 说明：full=redis+onlyoffice；search=meilisearch；storage=minio。
#       profile 必须与下文的 *_DRIVER 开关一致，否则 backend 启动即失败。
# =============================================================================

DOCFLOW_IMAGE_TAG=1.0.0
NPM_REGISTRY=https://registry.npmjs.org/
GOPROXY=https://goproxy.cn

# ---- 必填：核心与数据库 ----
JWT_SECRET=verify-stack-jwt-secret-0123456789abcdef012345
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=verify-postgres-pw
DATABASE_URL=postgres://docflow:verify-postgres-pw@postgres:5432/docflow?sslmode=disable
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=AdminPassword123
SEED_ADMIN_ROLE=admin

# ---- 入口：本机 HTTP 验证 ----
# APP_DOMAIN 不设或设 :80 时 Caddy 只监听 80（无 TLS）。
# 留空表示使用 compose 默认回退 :80。
APP_DOMAIN=
# localhost 验证必须 false，否则 http 下登录态不保持。
COOKIE_SECURE=false
COOKIE_DOMAIN=
# 站点对外基地址：浏览器实际访问地址（用于分享链接/邮件链接）。
PUBLIC_BASE_URL=http://127.0.0.1
# 独立内容 origin 用默认值即可（content.localhost 由 Caddy 本地自签）。
CONTENT_DOMAIN=content.localhost
# 采信 compose 内网 caddy 转发的 X-Forwarded-For。
TRUSTED_PROXIES=172.16.0.0/12

# ---- 存储：storage profile 的 MinIO ----
# 【注意】STORAGE_DRIVER=s3 必须叠加 --profile storage，且 bucket 需提前创建：
#   docker compose --profile storage up -d minio
#   docker run --rm --network docflow_default quay.io/minio/mc:latest \
#     alias set local http://minio:9000 docflow docflow-secret && \
#     docker run --rm --network docflow_default quay.io/minio/mc:latest mb local/docflow
# 若不需要 S3，改为 STORAGE_DRIVER=local 并去掉 --profile storage。
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docflow
S3_REGION=us-east-1
S3_ACCESS_KEY=docflow
S3_SECRET_KEY=docflow-secret
S3_PATH_STYLE=true

# ---- 队列：full profile 的 Redis ----
# QUEUE_DRIVER=redis 必须叠加 --profile full，否则启动 ping 失败即退出。
QUEUE_DRIVER=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
QUEUE_CONCURRENCY=5

# ---- 全文搜索：search profile 的 Meilisearch ----
# SEARCH_DRIVER=meili 必须叠加 --profile search；两个 KEY 须同值。
SEARCH_DRIVER=meili
MEILI_URL=http://meilisearch:7700
MEILI_API_KEY=verify-meili-master-key-0123456789abcdef
MEILI_MASTER_KEY=verify-meili-master-key-0123456789abcdef

# ---- ONLYOFFICE：full profile ----
# JWT_SECRET ≥32 字节，与 onlyoffice 服务共享（compose 强制非空）。
# PUBLIC_URL 指向浏览器经 caddy 反代的地址；本机验证用 http://127.0.0.1/onlyoffice。
ONLYOFFICE_ENABLED=true
ONLYOFFICE_SERVER_URL=http://onlyoffice:80
ONLYOFFICE_PUBLIC_URL=http://127.0.0.1/onlyoffice
ONLYOFFICE_JWT_SECRET=verify-onlyoffice-jwt-secret-0123456789
ONLYOFFICE_DOWNLOAD_URL_BASE=http://backend:8080
ONLYOFFICE_UPSTREAM=onlyoffice:80

# ---- draw.io：静态层已并入 caddy 镜像，无独立服务 ----
DRAWIO_ENABLED=true
DRAWIO_SERVER_URL=http://127.0.0.1/drawio
DRAWIO_PUBLIC_URL=http://127.0.0.1/drawio

# ---- 邮件：验证期 Noop（链接仅打印到后端日志）----
# 若用 scripts/compose-scale.yml 起的 mailpit，可设：
#   SMTP_ENABLED=true SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_FROM=docflow@example.com
SMTP_ENABLED=false

# ---- 病毒扫描：antivirus profile，默认关闭 ----
# 启用需叠加 --profile antivirus 并改 SCAN_ENABLED=true、CLAMAV_ADDR=clamav:3310。
# 注意 clamd 首次启动要下载病毒库（数分钟），期间上传 fail closed 被拒。
SCAN_ENABLED=false
CLAMAV_ADDR=clamav:3310

# ---- 限流：验证期放开，避免 Playwright/压力自测被拦截 ----
RATE_LIMIT_PER_MIN=0

# ---- 可选：OIDC（需自备 IdP，验证期通常关闭）----
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_AUTO_PROVISION=true

# ---- 可选：AI ----
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- 一般无需调整 ----
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MAX_FILE_SIZE=2147483648
PATCH_MAX_BYTES=67108864
UPLOAD_SESSION_TTL=24h
MAX_VERSIONS_PER_FILE=5
LOGIN_RATE_LIMIT_PER_MIN=10
PUBLIC_RATE_LIMIT_PER_MIN=60
JANITOR_ENABLED=true
JANITOR_INTERVAL=10m
METRICS_ENABLED=true
WEBPKG_ENABLED=true

# DocFlow 生产入口（设计文档 §12.2）。caddy 是唯一映射宿主端口（80/443）的
# 服务；前端静态产物在构建期拷入镜像 /srv/frontend（见 frontend/Dockerfile）。
#
# 站点地址取环境变量 APP_DOMAIN：未设置时默认 :80（本地验证，无 TLS）；
# 设为域名（如 docflow.example.com）时自动申请/续期 HTTPS 证书
#（ACME HTTP 挑战走 80 端口，已在 docker-compose.yml 映射）。
#
# HTTPS 运行时切换（管理页 → TLS）：backend 经 admin API 热下发与本文件
# 同构的配置（internal/caddytls.Render）。除 auto（自动证书）与 internal
#（自签）外支持 custom（自定义证书）：管理员在管理页上传 PEM 证书+私钥，
# backend 写入共享卷 /data/tls（tls_certs 卷，本容器只读挂载），热下发的
# tls 指令形如 `tls {$CADDY_TLS_CERT:/data/tls/cert.pem} {$CADDY_TLS_KEY:/data/tls/key.pem}`
#（docker-compose.yml 已注入这两个 env，含默认值）。公网域名场景用 auto
# 即可（自动 HTTPS 已覆盖）；custom 面向已持有企业证书的自托管用户。
#
# CONTENT_DOMAIN 为独立内容 origin；CONTENT_UPSTREAM 默认 backend:8080。
# 若 DNS/证书暂未就绪，仍可使用主站 /content/* 路径兼容入口。
#
# admin 块：admin API 监听地址（默认仅容器内 localhost:2019）。compose 部署
# 注入 CADDY_ADMIN=:2019 并 expose（不映射宿主端口），供 backend 管理页面
# HTTPS 运行时切换热下发配置（internal/caddytls 渲染的模板含同款占位，
# reload 后保持可达——注意勿在自定义配置中删除本块）。
{
	admin {$CADDY_ADMIN:localhost:2019}
}

{$APP_DOMAIN::80} {
	encode gzip

	# 安全响应头基线。不下发 CSP：CSP 由应用层提供——/content/* 由后端带
	# sandbox allow-scripts 的严格 CSP（须允许 sandbox iframe 嵌入，不加
	# frame-ancestors 限制），其余路径由应用自行控制；Caddy 不重复下发
	# 以免策略冲突。
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}

	# 基础探针：存活由 Caddy 自身提供，就绪转发到 backend。
	handle /health {
		respond 200
	}
	handle /ready {
		reverse_proxy backend:8080
	}

	# REST API → Go 后端（backend 仅 compose 内网，无宿主端口映射）。
	handle /api/* {
		reverse_proxy backend:8080
	}

	# 路径兼容：内容 origin 的安全策略和 Cookie 隔离由此代理保证。
	handle /content/* {
		header {
			-Cookie
			Content-Security-Policy "sandbox allow-scripts"
			X-Content-Type-Options nosniff
		}
		reverse_proxy {$CONTENT_UPSTREAM:backend:8080} {
			header_up -Cookie
		}
	}

	# 受控原始内容（/raw/*：路径型访问与目录分享子资源，HMAC grant 鉴权，
	# 无 Cookie 依赖）：与 /content/* 同区处理——剥 Cookie、sandbox CSP
	# （后端 /raw 端点自带同款 CSP 与 nosniff，此处模板保证反代路径一致）、
	# no-referrer（URL 内含短期 grant，不得外泄）。
	handle /raw/* {
		header {
			-Cookie
			Content-Security-Policy "sandbox allow-scripts"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		reverse_proxy {$CONTENT_UPSTREAM:backend:8080} {
			header_up -Cookie
		}
	}

	# MCP 服务（JSON-RPC over HTTP，PAT/access Bearer 鉴权，后端独立限流）。
	handle /mcp {
		reverse_proxy {$CONTENT_UPSTREAM:backend:8080}
	}

	# ONLYOFFICE Document Server（full profile）。上游经 ONLYOFFICE_UPSTREAM
	# 注入：minimal 下无 onlyoffice 服务，若此处写死 onlyoffice:80，Caddy 启动
	# 时静态上游 DNS 解析失败会直接退出，故默认指向本机 discard 端口
	#（127.0.0.1:9，minimal 下 /onlyoffice/* 返回 502 属预期）；
	# make up-full 会注入 ONLYOFFICE_UPSTREAM=onlyoffice:80。
	# 浏览器经本路径加载 api.js：.env 设 ONLYOFFICE_PUBLIC_URL=https://<域名>/onlyoffice
	#（后端 /onlyoffice/config 将其返回给浏览器；回调 SSRF 校验仍以内网
	# ONLYOFFICE_SERVER_URL 为基准，与本路径无关）。
	handle_path /onlyoffice/* {
		# handle_path 剥 /onlyoffice 前缀后转 DS；X-Forwarded-Prefix 为 DS
		# 8.x 官方子路径部署协议：DS（含 docservice Node 层 getBaseUrlByRequest
		# 与 nginx 层 $the_prefix map）据此给下发给浏览器的绝对 URL 加 /onlyoffice
		# 前缀。缺失时 docservice 生成的 Editor.bin 回源地址为根路径
		# /cache/files/...，经 Caddy 落 SPA 兜底返回 index.html，sdkjs 按
		# 内容识别格式失败，编辑器弹「文件内容与文件扩展名不匹配」且无法打开
		#（真实栈定位：sdkjs 抓到的 Editor.bin 为 696 字节 HTML）。
		# X-Forwarded-Path 为兼容新增 DS 版本的冗余头，8.2.3 不消费。
		reverse_proxy {$ONLYOFFICE_UPSTREAM:127.0.0.1:9} {
			header_up X-Forwarded-Prefix /onlyoffice
			header_up X-Forwarded-Path /onlyoffice
		}
	}

	# draw.io 图表编辑器静态层：官方 webapp 在构建期并入本镜像 /srv/drawio
	#（frontend/Dockerfile 第三阶段 → /srv/drawio，经 /drawio/* 路径服务），
	# 不再需要独立 drawio 服务（原 jgraph/drawio:27.0.9 容器内的 Tomcat/Java
	# 仅服务其自建站云盘 OAuth 回调，本场景不使用）。对应 .env 联动：
	# DRAWIO_ENABLED=true、DRAWIO_PUBLIC_URL=https://<对外域名>/drawio。
	@drawioEditor path_regexp drawioEditor ^/drawio/[0-9a-fA-F-]{36}$
	handle @drawioEditor {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	handle_path /drawio/* {
		root * /srv/drawio
		# 静态层无内容哈希文件名（随镜像版本整体更新），给一天缓存平衡
		# 重复访问流量与镜像升级生效速度；不使用 immutable。
		header Cache-Control "public, max-age=86400"
		try_files {path} /index.html
		file_server
	}

	# /metrics 与 backend 的 /health、/ready 不写反代规则即不经 Caddy 暴露
	#（未匹配路径落到下方 SPA，返回 index.html 而非指标）；内网监控在
	# compose 网络内直连 backend:8080/metrics 抓取，或设 METRICS_ENABLED=false。

	# 前端 SPA 静态产物（构建期拷入 /srv/frontend）：
	# - /assets/* 文件名内含内容哈希（vite 产物），内容永不复用文件名，
	#   可永久缓存（含 SW 预缓存与 HTTP 缓存，浏览器二次访问零请求）；
	# - 其余路径（index.html / sw.js / manifest / 图标）发版即变，须每次
	#   经验证（no-cache 允许缓存副本但使用前 304 校验），保证发布后
	#   用户刷新即得新版本，PWA 更新提示也能及时出现。
	handle /assets/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	log {
		output stdout
	}
}

# 独立内容 origin：CONTENT_DOMAIN 需解析到本机并配置证书（生产建议独立域名）。
# 路径兼容仍保留在上方主站 block；该 block 不承载 API 或 SPA。
{$CONTENT_DOMAIN:content.localhost} {
	encode gzip
	header {
		-Cookie
		Content-Security-Policy "sandbox allow-scripts"
		X-Content-Type-Options nosniff
	}
	reverse_proxy /content/* {$CONTENT_UPSTREAM:backend:8080} {
		header_up -Cookie
	}
	respond / 404
}

POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgres://docflow:change-this-password@localhost:5432/docflow?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
PORT=8080
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# 会话 cookie 是否仅经 HTTPS 传输：默认 true（与后端/compose 默认一致，
# 生产 HTTPS 保持默认）；本地 http 访问（如 localhost:8080 / vite 代理）
# 必须显式设 false，否则浏览器不会回传 refresh cookie，无法保持登录。
COOKIE_SECURE=false
COOKIE_DOMAIN=
# 可信代理 CIDR/IP 列表（逗号分隔，TRUSTED_PROXIES）：控制后端是否采信
# X-Forwarded-For。默认空 = 不信任任何代理（ClientIP 取直连地址），
# 防伪造 XFF 绕过按 IP 限流；经反向代理（caddy/nginx）部署时需设置为
# 代理所在网段（compose 内 caddy 通常在 172.16.0.0/12 段，例如
# TRUSTED_PROXIES=172.16.0.0/12）。
TRUSTED_PROXIES=
RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT_PER_MIN=10
PUBLIC_RATE_LIMIT_PER_MIN=60

# ---- 存储 ----
# 存储驱动：local | s3（默认 local）
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# 单文件上传大小上限（字节）。运行时可被 system_settings 的
# upload.max_file_size 热覆盖（本值为读取失败时的回退）。
MAX_FILE_SIZE=2147483648
# 单次上传 PATCH 请求体上限（字节，默认 64MiB=67108864）：流式复制不整读
# 缓冲，该上限约束单请求的存储写入量与连接占用时长。
PATCH_MAX_BYTES=67108864

# S3 兼容对象存储（MinIO/AWS 等，STORAGE_DRIVER=s3 时生效）。
# S3_ENDPOINT 为空表示 AWS 默认端点；S3_PATH_STYLE 建议对自建服务保持 true。
# compose 部署（storage profile 的 MinIO，需提前创建 bucket）用
# http://minio:9000；本文件值用于本地直连开发（docker run -p 9000:9000
# quay.io/minio/minio server /data，MinIO 已从 Docker Hub 下架）。曾用
# SeaweedFS，验证中其 S3 DELETE 间歇 500 已弃用，编排注释中保留自建示例。
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=docflow
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true

# ---- 病毒扫描（clamd INSTREAM） ----
# SCAN_ENABLED=true 且 CLAMAV_ADDR 非空时启用 ClamAV 扫描。
# 本地开发直连 localhost:3310；docker 部署（--profile antivirus）用
# clamav:3310（compose 内网服务名，容器内 localhost 不可达）。
SCAN_ENABLED=false
CLAMAV_ADDR=localhost:3310
# 单次扫描超时
CLAMAV_TIMEOUT=5m
# true（默认，fail closed）：clamd 不可达即拒绝上传；
# false：拨号失败时降级放行并记录警告日志。
CLAMAV_REQUIRED=true

UPLOAD_SESSION_TTL=24h

# ---- 文件版本管理 ----
# 每文件保留的版本数上限：覆盖上传为新版本后，超出部分按版本号裁剪
#（current_version 指向的版本始终保留）。
# 运行时可被 system_settings 的 upload.max_versions_per_file 热覆盖（本值为读取失败时的回退）。
MAX_VERSIONS_PER_FILE=5

# ---- 后台清理任务（janitor） ----
# 过期上传会话置 failed 并删 tmp/* 临时对象、终态会话超 24h 删行、
# deleting 且零引用的 blob 行锁复核后物理删除、回收站超 retention.trash_days 彻底删除。
# JANITOR_ENABLED 默认 true（设为 false 关闭）。
JANITOR_ENABLED=true
# 清理周期（默认 10m；启动即先跑一轮）。
JANITOR_INTERVAL=10m

# ---- 系统设置（system_settings，管理员 API 热调整） ----
# 内置键：upload.max_versions_per_file、upload.max_file_size、
# share.default_expiry_hours（分享未指定有效期时的默认小时数）、retention.trash_days。
# 非密钥原则：密钥类配置（JWT/S3/SMTP 凭据等）只走环境变量，不入 system_settings。
# 初始管理员：SEED_ADMIN_EMAIL/PASSWORD/USERNAME/ROLE（cmd/seed，ROLE 默认 admin）。

# ---- ONLYOFFICE Document Server 集成（v1.0，默认关闭） ----
# 启用（ONLYOFFICE_ENABLED=true）要求：
#   - ONLYOFFICE_SERVER_URL：DocumentServer 内网基地址，同时是回调下载 URL
#     防 SSRF 校验的同源基准（compose 内为 http://onlyoffice:80）；
#   - ONLYOFFICE_PUBLIC_URL：浏览器可达的 DocumentServer 地址（/onlyoffice/config
#     返回给前端加载 api.js）。留空回退 ONLYOFFICE_SERVER_URL——但内网名浏览器
#     无法解析，生产部署务必设置：compose full profile 经 caddy /onlyoffice/*
#     反代时为 https://<对外域名>/onlyoffice；本地直连 DS 时如 http://localhost:8081。
#     注意：本值不影响 SSRF 校验（始终以 SERVER_URL 为基准）；
#   - ONLYOFFICE_JWT_SECRET：与 DocumentServer 的 JWT_SECRET 共享（≥32 字节，
#     建议与主 JWT_SECRET 不同，openssl rand -hex 32 生成）；
#   - ONLYOFFICE_DOWNLOAD_URL_BASE：DocumentServer 回源访问后端用的基地址
#     （编辑配置中 document.url / callbackUrl 的前缀，compose 内为 http://backend:8080）。
# 未启用时后端不注册 /api/v1/onlyoffice 路由（请求 404）。
# compose 启动 DocumentServer：make up-full（或 docker compose --profile full up -d，
# 需同时注入 ONLYOFFICE_UPSTREAM=onlyoffice:80）。
ONLYOFFICE_ENABLED=false
ONLYOFFICE_SERVER_URL=http://onlyoffice:80
ONLYOFFICE_PUBLIC_URL=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_DOWNLOAD_URL_BASE=http://backend:8080
# onlyoffice 公开组（download/callback）独立按 IP 轻限流。
ONLYOFFICE_RATE_LIMIT_PER_MIN=60

# ---- draw.io 图表编辑集成（v1.0，默认关闭） ----
# 编辑器为浏览器侧 iframe embed（postMessage JSON 协议：init→load→save），
# 后端仅提供 /api/v1/drawio/config 探测端点；保存走「上传 file_id 覆盖为
# 新版本」通用链路（.drawio 文件，新建即上传初始模板，无专用创建端点）。
# 启用（DRAWIO_ENABLED=true）要求：
#   - DRAWIO_SERVER_URL：drawio 服务内网基地址（DRAWIO_PUBLIC_URL 未设置时
#     作为前端回退地址；compose full profile 为 http://drawio:8080）；
#   - DRAWIO_PUBLIC_URL：浏览器可达的 drawio 地址（/drawio/config 返回给
#     前端加载 iframe 编辑器）。留空回退 DRAWIO_SERVER_URL——内网名浏览器
#     无法解析，生产部署务必设置：compose full profile 经 caddy /drawio/*
#     反代时为 https://<APP_DOMAIN>/drawio（APP_DOMAIN 即 compose .env 的
#     对外域名，联动 Caddy 站点地址与 /drawio/* 反代路径）；本地直连
#     drawio 容器时如 http://localhost:8082。
# compose 启动 drawio 服务：make up-full（同时注入 DRAWIO_UPSTREAM=drawio:8080
# 供 caddy 反代，否则 caddy 在 drawio 未运行时不解析该主机名）。
DRAWIO_ENABLED=false
DRAWIO_SERVER_URL=http://drawio:8080
DRAWIO_PUBLIC_URL=

# ---- Caddy 内容独立 origin ----
# 生产建议将 CONTENT_DOMAIN 指向独立域名；路径 /content/* 兼容入口始终保留。
CONTENT_DOMAIN=content.example.com
CONTENT_UPSTREAM=backend:8080

# ---- 可观测性（Prometheus） ----
# GET /metrics 暴露 Prometheus 指标（HTTP 请求、上传会话与阶段耗时、扫描结果、
# ONLYOFFICE 回调，以及 client_golang 自带的 go_*/process_* 进程指标）。
# 端点无认证：生产部署务必由反向代理（Caddy）或网络层限制访问。
METRICS_ENABLED=true

# ---- 网页包（zip）安全预览 ----
# 上传完成（blob available）后对 zip 候选文件自动尝试解包；失败置 blocked，
# 不影响文件本身可用性。也可经 POST /api/v1/files/:id/webpkg/extract 手动解包。
# 内容端点 GET /content/<public_id>/<path>：无认证、独立按 IP 轻限流，
# 携带严格 CSP（sandbox allow-scripts）与 nosniff，不携带主站 Cookie/认证。
WEBPKG_ENABLED=true
# 解包安全限制：条目数 / 单文件展开大小 / 展开总大小 / 目录深度。
WEBPKG_MAX_ENTRIES=500
WEBPKG_MAX_FILE_SIZE=33554432
WEBPKG_MAX_TOTAL_SIZE=268435456
WEBPKG_MAX_DEPTH=10
# /content 内容端点独立按 IP 轻限流（每分钟次数）。
WEBPKG_RATE_LIMIT_PER_MIN=120

# ---- 后台任务队列（多实例横向扩展） ----
# QUEUE_DRIVER：inprocess（默认，进程内 goroutine 直接执行，零依赖）| redis
# （asynq 队列，任意实例可消费，适合多实例部署）。
# redis 驱动要求 Redis 可达：启动时 ping 校验失败即退出（fail fast）；
# compose 部署用 --profile full（或 make up-full），compose 已默认
# REDIS_ADDR=redis:6379（本文件值用于本地直连开发）。
# 多实例注意事项：共享存储 S3 下上传/网页包临时对象天然多实例安全；
# STORAGE_DRIVER=local（LocalStorage）为单机实现，多实例需共享卷或改用 S3。
QUEUE_DRIVER=inprocess
REDIS_ADDR=localhost:6379
# Redis 密码（无认证留空）。
REDIS_PASSWORD=
# redis 驱动下每实例并行处理任务数。
QUEUE_CONCURRENCY=5

# ---- 邮件通道（邀请注册 / 密码重置链接） ----
# SMTP_ENABLED=false（默认）：使用 Noop 邮件通道——不发送邮件、不建立任何
# 网络连接，仅把邀请/重置链接输出到后端日志（[mail:noop] 前缀），
# 管理员仍可从「管理 → 邀请管理」复制一次性注册链接。
# SMTP_ENABLED=true 时经 net/smtp 投递（简单实现：纯文本邮件、可选 PLAIN
# 认证，服务端通告 STARTTLS 时自动协商），要求 SMTP_HOST 与 SMTP_FROM 必填。
SMTP_ENABLED=false
SMTP_HOST=
# SMTP 端口（默认 587；465 通常为隐式 TLS，net/smtp 简单实现不支持）。
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 站点对外基地址（如 https://docflow.example.com）：用于拼接邮件中的
# 邀请注册（/register/<token>）与密码重置（/reset/<token>）绝对链接；
# 留空时邮件/日志输出相对路径。启用 SMTP 时建议配置。
PUBLIC_BASE_URL=

# ---- OIDC 单点登录（v2，默认关闭） ----
# 通用 OIDC 客户端（授权码流程 + PKCE S256，标准库实现，无新依赖）。
# 启用（OIDC_ENABLED=true）要求：
#   - OIDC_ISSUER：IdP 签发方基地址（如 https://accounts.google.com），
#     启动时拉取 {issuer}/.well-known/openid-configuration 发现文档
#     （失败即拒绝启动）；
#   - OIDC_CLIENT_ID / OIDC_CLIENT_SECRET：IdP 侧注册的应用凭据；
#   - OIDC_REDIRECT_URL：授权码回调地址，留空时取
#     {PUBLIC_BASE_URL}/api/v1/auth/oidc/callback（PUBLIC_BASE_URL 也未
#     设置时启动校验失败——IdP 侧必须注册确切回调地址）。
# 用户映射：oidc_links（sub 关联，migration 021）→ email 匹配既有 active
# 用户 → 自动开户（OIDC_AUTO_PROVISION，默认 true：role=user、随机不可
# 登录密码、审计 oidc.provision）；设为 false 时无匹配一律 403（联系
# 管理员）。安全取舍：SSO 信任 IdP 认证强度，跳过本地 TOTP 二验
#（密码登录的 TOTP 拦截不变）。
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_AUTO_PROVISION=true

# ---- AI 文件摘要（v2 可落地子集，默认关闭） ----
# OpenAI 兼容 /chat/completions：AI_BASE_URL 可指向任意兼容网关（OneAPI/
# vLLM/azure 代理等）；system 提示固定「用与文件相同的语言总结以下文件内容，
# 300 字内」，max_tokens 500，超时 60s。
# 启用（AI_ENABLED=true）要求 AI_API_KEY 必填；文件须为文本类（扩展名/
# mime 白名单同全文索引）且当前版本 available，内容 >100KB 返回 413。
# 未启用时 POST /api/v1/files/:id/ai/summary 恒 503 AI_DISABLED。
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- 全文搜索引擎（v2 可选项） ----
# SEARCH_DRIVER：pg（默认，PostgreSQL 原生 ILIKE+tsvector）| meili。
# meili 要求 MEILI_URL 必填（启动即创建索引 docflow-files，不可达拒绝启动）；
# MEILI_API_KEY 对应实例 MASTER_KEY（未设 MASTER_KEY 的本地实例可留空）。
# 注意：meili 驱动下 /search 的 tag_id/starred 过滤暂不支持（请求会得到
# 500 unable to search），结果的 parent_id/updated_at 取零值（v1 子集，
# 索引不含这些字段）。
# compose 部署：docker compose --profile search up -d（服务名 meilisearch:7700），
# 本文件值用于本地直连开发。
SEARCH_DRIVER=pg
MEILI_URL=http://localhost:7700
MEILI_API_KEY=
# meilisearch 实例的 MASTER_KEY（compose search profile 用；设为 ≥16 字节
# 随机串并同步到 MEILI_API_KEY，留空 = 无认证实例，仅限内网）。
MEILI_MASTER_KEY=

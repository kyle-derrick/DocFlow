POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgres://docflow:change-this-password@localhost:5432/docflow?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
PORT=8080
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false
COOKIE_DOMAIN=
RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT_PER_MIN=10
PUBLIC_RATE_LIMIT_PER_MIN=60

# ---- 存储 ----
# 存储驱动：local | s3（默认 local）
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
MAX_FILE_SIZE=1073741824

# S3 兼容对象存储（SeaweedFS/MinIO/AWS），STORAGE_DRIVER=s3 时生效。
# S3_ENDPOINT 为空表示 AWS 默认端点；S3_PATH_STYLE 建议对自建服务保持 true。
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=docflow
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true

# ---- 病毒扫描（clamd INSTREAM） ----
# SCAN_ENABLED=true 且 CLAMAV_ADDR 非空时启用 ClamAV 扫描。
# 本地开发直连 localhost:3310；docker 部署（--profile antivirus）用
# clamav:3310（compose 内网服务名，容器内 localhost 不可达）。
SCAN_ENABLED=false
CLAMAV_ADDR=localhost:3310
# 单次扫描超时
CLAMAV_TIMEOUT=5m
# true（默认，fail closed）：clamd 不可达即拒绝上传；
# false：拨号失败时降级放行并记录警告日志。
CLAMAV_REQUIRED=true

UPLOAD_SESSION_TTL=24h

# ---- 文件版本管理 ----
# 每文件保留的版本数上限：覆盖上传为新版本后，超出部分按版本号裁剪
#（current_version 指向的版本始终保留）。
# 运行时可被 system_settings 的 upload.max_versions_per_file 热覆盖（本值为读取失败时的回退）。
MAX_VERSIONS_PER_FILE=5

# ---- 后台清理任务（janitor） ----
# 过期上传会话置 failed 并删 tmp/* 临时对象、终态会话超 24h 删行、
# deleting 且零引用的 blob 行锁复核后物理删除、回收站超 retention.trash_days 彻底删除。
# JANITOR_ENABLED 默认 true（设为 false 关闭）。
JANITOR_ENABLED=true
# 清理周期（默认 10m；启动即先跑一轮）。
JANITOR_INTERVAL=10m

# ---- 系统设置（system_settings，管理员 API 热调整） ----
# 内置键：site.name、upload.max_versions_per_file、upload.max_file_size、
# share.default_expiry_hours、retention.trash_days。
# 非密钥原则：密钥类配置（JWT/S3/SMTP 凭据等）只走环境变量，不入 system_settings。
# 初始管理员：SEED_ADMIN_EMAIL/PASSWORD/USERNAME/ROLE（cmd/seed，ROLE 默认 admin）。

# ---- ONLYOFFICE Document Server 集成（v1.0，默认关闭） ----
# 启用（ONLYOFFICE_ENABLED=true）要求：
#   - ONLYOFFICE_SERVER_URL：DocumentServer 基地址，同时是回调下载 URL 防 SSRF
#     校验的同源基准（compose 内为 http://onlyoffice:80）；
#   - ONLYOFFICE_JWT_SECRET：与 DocumentServer 的 JWT_SECRET 共享（≥32 字节，
#     建议与主 JWT_SECRET 不同，openssl rand -hex 32 生成）；
#   - ONLYOFFICE_DOWNLOAD_URL_BASE：DocumentServer 回源访问后端用的基地址
#     （编辑配置中 document.url / callbackUrl 的前缀，compose 内为 http://backend:8080）。
# 未启用时后端不注册 /api/v1/onlyoffice 路由（请求 404）。
# compose 启动 DocumentServer：make up-full（或 docker compose --profile full up -d，
# 需同时注入 ONLYOFFICE_UPSTREAM=onlyoffice:80）。
ONLYOFFICE_ENABLED=false
ONLYOFFICE_SERVER_URL=http://onlyoffice:80
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_DOWNLOAD_URL_BASE=http://backend:8080
# onlyoffice 公开组（download/callback）独立按 IP 轻限流。
ONLYOFFICE_RATE_LIMIT_PER_MIN=60

# ---- 可观测性（Prometheus） ----
# GET /metrics 暴露 Prometheus 指标（HTTP 请求、上传会话与阶段耗时、扫描结果、
# ONLYOFFICE 回调，以及 client_golang 自带的 go_*/process_* 进程指标）。
# 端点无认证：生产部署务必由反向代理（Caddy）或网络层限制访问。
METRICS_ENABLED=true

# ---- 网页包（zip）安全预览 ----
# 上传完成（blob available）后对 zip 候选文件自动尝试解包；失败置 blocked，
# 不影响文件本身可用性。也可经 POST /api/v1/files/:id/webpkg/extract 手动解包。
# 内容端点 GET /content/<public_id>/<path>：无认证、独立按 IP 轻限流，
# 携带严格 CSP（sandbox allow-scripts）与 nosniff，不携带主站 Cookie/认证。
WEBPKG_ENABLED=true
# 解包安全限制：条目数 / 单文件展开大小 / 展开总大小 / 目录深度。
WEBPKG_MAX_ENTRIES=500
WEBPKG_MAX_FILE_SIZE=33554432
WEBPKG_MAX_TOTAL_SIZE=268435456
WEBPKG_MAX_DEPTH=10
# /content 内容端点独立按 IP 轻限流（每分钟次数）。
WEBPKG_RATE_LIMIT_PER_MIN=120

# ---- 后台任务队列（多实例横向扩展） ----
# QUEUE_DRIVER：inprocess（默认，进程内 goroutine 直接执行，零依赖）| redis
# （asynq 队列，任意实例可消费，适合多实例部署）。
# redis 驱动要求 Redis 可达：启动时 ping 校验失败即退出（fail fast）；
# compose 部署用 --profile full（或 make up-full）并设 REDIS_ADDR=redis:6379。
# 多实例注意事项：共享存储 S3 下上传/网页包临时对象天然多实例安全；
# STORAGE_DRIVER=local（LocalStorage）为单机实现，多实例需共享卷或改用 S3。
QUEUE_DRIVER=inprocess
REDIS_ADDR=localhost:6379
# Redis 密码（无认证留空）。
REDIS_PASSWORD=
# redis 驱动下每实例并行处理任务数。
QUEUE_CONCURRENCY=5
